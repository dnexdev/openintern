{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p .vercel-static && printf 'openintern\\n' > .vercel-static/_build.txt",
  "outputDirectory": ".vercel-static",
  "functions": {
    "api/index.go": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
