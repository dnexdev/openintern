# Optional override for the jobs dump URL (defaults to GitHub dump-latest release).
# JOBS_DUMP_URL=https://github.com/dnexdev/openintern/releases/download/dump-latest/jobs.json

# Optional health snapshot URL (ingest digest JSON). Falls back to the dump's health.json.
# HEALTH_SNAPSHOT_URL=

# Optional kill-switch JSON URL (hide jobs/companies/hosts; maintenance mode).
# OPENINTERN_KILL_SWITCH_URL=

# Whole site 503 (status endpoint stays up).
# OPENINTERN_MAINTENANCE=1

# Rate limiting (requests per minute for /api/v1). Default 60.
# Present-but-empty denies all requests.
API_RATE_LIMIT_PER_MINUTE=60

# Vercel Web Analytics script when set to "vercel".
# OPENINTERN_ANALYTICS=vercel

# Apply-link allowlist (data/apply-hosts.tsv): warn (default, logs only), enforce, or off.
# OPENINTERN_APPLY_HOSTS=warn

# Tesla / Citadel come from committed manual captures (data/manual/README.md).
# OPENINTERN_SHADOW_HONEST=1
# OPENINTERN_ONLY_SLUGS=citadel,citadel-securities,tesla

# One-shot Neon export only (export-state workflow). Not used by the site or daily ingest.
# DATABASE_URL=postgresql://…
