# Postgres (Neon or local Docker Compose)
# Prefer the pooled Neon URL (-pooler) on Vercel. Ingest/Dump Actions may use direct.
DATABASE_URL=postgresql://openintern:openintern@localhost:5432/openintern

# Public board/API prefer the daily GitHub dump (saves Neon CU). Set to 1 for live DB-first.
# OPENINTERN_PREFER_DB=1

# Optional override for the jobs dump URL (defaults to GitHub dump-latest release).
# JOBS_DUMP_URL=https://github.com/dnexdev/openintern/releases/download/dump-latest/jobs.json

# Rate limiting (requests per minute for /v1)
API_RATE_LIMIT_PER_MINUTE=60

# Privacy-friendly analytics (Plausible). Set on Vercel to enable; leave unset to disable.
# Create a site at https://plausible.io for openintern.dev, then:
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=openintern.dev

# Proprietary careers (Citadel / Tesla) when CDN returns 403:
# OPENINTERN_BROWSER=1
# OPENINTERN_CITADEL_HTML_PATH=./dumps/citadel-open-opportunities.html
# OPENINTERN_CITADEL_SECURITIES_HTML_PATH=./dumps/citadel-securities-open-opportunities.html
# OPENINTERN_TESLA_STATE_PATH=./dumps/tesla-state.json
# OPENINTERN_AVATURE_HTML_PATH=./dumps/bloomberg-searchjobs.html
# OPENINTERN_ICIMS_HTML_PATH=./dumps/sig-icims-search.html
# OPENINTERN_X_HTML_PATH=./dumps/x-careers.html
# OPENINTERN_ONLY_SLUGS=citadel,citadel-securities,tesla
