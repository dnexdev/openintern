{
  "name": "openintern",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source tech internship corpus \u2014 free API, no-account board, community company registry.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "go run ./cmd/openintern serve -addr 127.0.0.1:3000",
    "test": "pnpm --filter @openintern/ingest test && pnpm --filter @openintern/proven test",
    "proofs": "go run ./cmd/openintern proofs check",
    "proofs:build": "go run ./cmd/openintern proofs build",
    "gen-apply-hosts": "pnpm --filter @openintern/ingest gen-apply-hosts",
    "gen-aliases": "pnpm --filter @openintern/ingest gen-aliases",
    "job-aliases": "pnpm --filter @openintern/ingest job-aliases"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping": "2.11.28",
      "esbuild": "^0.25.12",
      "nanoid@3": "3.3.20",
      "postcss": "8.5.29",
      "shell-quote": "1.12.0",
      "source-map-js": "1.2.2"
    }
  }
}
